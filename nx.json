{
  "workspaceLayout": {
    "appsDir": "projects/storefrontapp",
    "libsDir": "feature-libs"
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build", "build-schematics"],
      "cache": true
    },
    "build-schematics": {
      "dependsOn": ["schematics:build-schematics"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "e2e": {
      "cache": true
    }
  },
  "useInferencePlugins": false
}
