{
  "workspaceLayout": {
    "appsDir": "projects/storefrontapp",
    "libsDir": "feature-libs"
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/{projectName}"]
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "e2e": {
      "cache": true
    }
  },
  "useInferencePlugins": false,
  "analytics": false
}
