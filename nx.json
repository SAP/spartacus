{
  "workspaceLayout": {
    "appsDir": "projects/storefrontapp",
    "libsDir": "feature-libs"
  },
  "plugins": [
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test-vitest"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "e2e": {
      "cache": true
    }
  },
  "useInferencePlugins": false,
  "analytics": false
}
