{
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "node",
    "target": "ES2022",
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "dom"]
  },
  "include": ["**/*.ts"]
}
