{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "core-libs/core/src",
  "projectType": "library",
  "prefix": "cx",
  "targets": {
    "build": {
      "executor": "./tools/build-lib:declaration-merging",
      "options": {
        "tsConfig": "core-libs/core/tsconfig.lib.json",
        "project": "core-libs/core/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "core-libs/core/tsconfig.lib.prod.json"
        }
      }
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "main": "core-libs/core/src/test.ts",
        "tsConfig": "core-libs/core/tsconfig.spec.json",
        "polyfills": ["zone.js", "zone.js/testing"],
        "karmaConfig": "core-libs/core/karma.conf.js"
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["core-libs/core/**/*.ts", "core-libs/core/**/*.html"]
      }
    }
  },
  "tags": ["type:util", "scope:core"]
}
