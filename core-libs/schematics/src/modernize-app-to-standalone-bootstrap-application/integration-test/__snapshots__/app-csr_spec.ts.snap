exports[`Schematics "modernize-app-to-standalone-bootstrap-application" in CSR app src/app/app.config.ts should be created 1`] = `
"
import {
  ApplicationConfig,
  importProvidersFrom,
  provideBrowserGlobalErrorListeners,
  provideZoneChangeDetection
} from '@angular/core';
import {
  provideHttpClient,
  withFetch,
  withInterceptorsFromDi,
} from '@angular/common/http';
import { AppModule } from './app.module';

export const appConfig: ApplicationConfig = {
  providers: [
    provideBrowserGlobalErrorListeners(),
    provideZoneChangeDetection({ eventCoalescing: true }),
    provideHttpClient(withFetch(), withInterceptorsFromDi()),
    importProvidersFrom(AppModule),
  ],
};
"
`;

exports[`Schematics "modernize-app-to-standalone-bootstrap-application" in CSR app src/app/app.module.ts should be edited 1`] = `
"import { NgModule } from '@angular/core';
import { EffectsModule } from '@ngrx/effects';
import { StoreModule } from '@ngrx/store';
import { AppRoutingModule } from './app-routing.module';
import { SpartacusModule } from './spartacus/spartacus.module';

@NgModule({
  imports: [
    AppRoutingModule,
    StoreModule.forRoot({}),
    EffectsModule.forRoot([]),
    SpartacusModule,
  ]
})
export class AppModule { }
"
`;

exports[`Schematics "modernize-app-to-standalone-bootstrap-application" in CSR app src/main.ts should be edited 1`] = `
