{
  "$schema": "http://json-schema.org/schema",
  "$id": "SpartacusAiContextSchematics",
  "title": "Spartacus AI Context",
  "type": "object",
  "properties": {
    "aiTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["claude", "agents"]
      },
      "default": [],
      "description": "Which AI tools to configure with Spartacus best practices.",
      "x-prompt": {
        "type": "list",
        "multiselect": true,
        "message": "Which AI tools should I configure with Spartacus best practices?",
        "items": [
          {
            "value": "claude",
            "label": "Claude (.claude/skills/spartacus-developer/)"
          },
          {
            "value": "agents",
            "label": "Other agents (.agents/skills/spartacus-developer/)"
          }
        ]
      }
    },
    "debug": {
      "description": "Display additional details during the running process.",
      "type": "boolean",
      "default": false
    }
  },
  "required": []
}
