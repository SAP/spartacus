{
  "$schema": "http://json-schema.org/schema",
  "$id": "SpartacusAiContextSchematics",
  "title": "Spartacus AI Context",
  "type": "object",
  "properties": {
    "aiTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["agents", "claude"]
      },
      "default": ["agents"],
      "description": "Select the local folder(s) to install Spartacus development and major-upgrade skills",
      "x-prompt": {
        "type": "list",
        "multiselect": true,
        "message": "Select the local folder(s) to install Spartacus development and major-upgrade skills",
        "items": [
          {
            "value": "agents",
            "label": ".agents (.agents/skills/)"
          },
          {
            "value": "claude",
            "label": ".claude (.claude/skills/)"
          }
        ]
      }
    },
    "debug": {
      "description": "Display additional details during the running process.",
      "type": "boolean",
      "default": false
    }
  },
  "required": []
}
