{
  "name": "@spartacus/assets",
  "version": "221121.15.0-1",
  "homepage": "https://github.com/SAP/spartacus",
  "repository": "https://github.com/SAP/spartacus/tree/develop/core-libs/assets",
  "scripts": {
    "build": "nx build assets --configuration production && npm run generate:translations:ts-2-json",
    "generate:translations:properties-2-ts": "ts-node ./generate-translations-properties-2-ts && cd ../.. && npx prettier \"./core-libs/assets/src/translations/**/*.ts\" --write",
    "generate:translations:ts-2-json": "ts-node ./generate-translations-ts-2-json",
    "generate:translations:ts-2-properties": "ts-node ./generate-translations-ts-2-properties"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": "^22.22.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
