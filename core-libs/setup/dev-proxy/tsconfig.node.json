{
  "$schema": "../../../../node_modules/typescript/lib/tsconfig-schema.json",
  "compilerOptions": {
    "outDir": "../../../dist/setup/dev-proxy",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2022",
    "types": ["node"],
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
