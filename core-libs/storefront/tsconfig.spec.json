{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "module": "preserve",
    "strict": false,
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "moduleResolution": "bundler",
    "allowJs": true,
    "paths": {
      "@spartacus/core/testing/feature-toggles": [
        "../../core-libs/core/src/features-config/feature-toggles/testing/index.ts"
