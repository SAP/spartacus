      ],
      "@spartacus/core/testing/i18n": [
        "../../core-libs/core/src/i18n/testing/index.ts"
      ],
      "@spartacus/core/testing/url-testing": [
        "../../core-libs/core/src/routing/configurable-routes/url-translation/testing/url-testing.module.ts"
      ]
    }
  },
  "files": ["../../testing/setup-vitest.ts"],
  "include": [
    "**/*.ts",
    "../../core-libs/core/src/**/*.ts",
    "../../core-libs/storefront/**/*.ts",
    "../../feature-libs/**/*.ts"
  ]
