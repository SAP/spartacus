      "@spartacus/core/testing/user-reducers": [
        "../../core-libs/core/src/user/store/reducers/index.ts"
      ],
      "@spartacus/core/testing/mock-occ-endpoints": [
        "../../core-libs/core/src/occ/adapters/user/unit-test.helper.ts"
      ],
      "@spartacus/core/testing/mock-url-pipe": [
        "../../core-libs/core/src/routing/configurable-routes/url-translation/testing/mock-url.pipe.ts"
      ],
      "@spartacus/storefront/testing/mock-feature-directive": [
