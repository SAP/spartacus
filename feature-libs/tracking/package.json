{
  "name": "@spartacus/tracking",
  "version": "221121.777.0-1",
  "description": "Spartacus tracking and personalization library",
  "keywords": [
    "spartacus",
    "framework",
    "storefront",
    "tracking",
    "tms",
    "adobe launch",
    "gtm",
    "personalization"
  ],
  "homepage": "https://github.com/SAP/spartacus",
  "repository": "https://github.com/SAP/spartacus/tree/develop/feature-libs/tracking",
  "license": "Apache-2.0",
  "type": "commonjs",
  "scripts": {
    "build:schematics": "npm run clean:schematics && ../../node_modules/.bin/tsc -p ./tsconfig.schematics.json",
    "clean:schematics": "../../node_modules/.bin/rimraf --glob \"schematics/**/*.js\" \"schematics/**/*.js.map\" \"schematics/**/*.d.ts\"",
    "test:schematics": "npm --prefix ../../core-libs/schematics/ run clean && npm run clean:schematics && ../../node_modules/.bin/jest --config ./jest.schematics.config.js"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.2.17",
    "@angular/common": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@spartacus/core": "221121.777.0-1",
    "@spartacus/schematics": "221121.777.0-1",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": "^22.22.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json"
}
