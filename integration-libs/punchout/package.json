{
  "name": "@spartacus/punchout",
  "version": "221121.10.0",
  "description": "punchout library for Spartacus",
  "keywords": [
    "spartacus",
    "framework",
    "storefront",
    "punchout"
  ],
  "homepage": "https://github.com/SAP/spartacus",
  "repository": "https://github.com/SAP/spartacus/tree/develop/integration-libs/punchout",
  "license": "Apache-2.0",
  "exports": {
    "./*": {
      "sass": "./*"
    }
  },
  "scripts": {
    "build:schematics": "npm run clean:schematics && ../../node_modules/.bin/tsc -p ./tsconfig.schematics.json",
    "clean:schematics": "../../node_modules/.bin/rimraf --glob \"schematics/**/*.js\" \"schematics/**/*.js.map\" \"schematics/**/*.d.ts\"",
    "test:schematics": "npm --prefix ../../core-libs/schematics/ run clean && npm run clean:schematics && ../../node_modules/.bin/jest --config ./jest.schematics.config.js"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.2.8",
    "@angular/common": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@ngrx/store": "^21.0.1",
    "@spartacus/cart": "221121.10.0",
    "@spartacus/core": "221121.10.0",
    "@spartacus/schematics": "221121.10.0",
    "@spartacus/storefront": "221121.10.0",
    "@spartacus/styles": "221121.10.0",
    "rxjs": "^7.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json"
}
