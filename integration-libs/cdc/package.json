  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@ng-select/ng-select": "^21.1.4",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@spartacus/asm": "221121.7.0-1",
    "@spartacus/core": "221121.7.0-1",
    "@spartacus/organization": "221121.7.0-1",
    "@spartacus/schematics": "221121.7.0-1",
    "@spartacus/storefront": "221121.7.0-1",
    "@spartacus/user": "221121.7.0-1",
    "rxjs": "^7.8.0"
  },
  "engines": {
    "node": "^22.22.0"
  },
