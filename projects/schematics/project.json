{
  "name": "schematics",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/schematics/src",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["projects/schematics/**/*.ts"]
      }
    },
    "test-jest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test",
        "cwd": "projects/schematics"
      }
    },
    "build-schematics": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/index.js",
        "{projectRoot}/index.js.map",
        "{projectRoot}/src/**/*.js",
        "{projectRoot}/src/**/*.js.map",
        "{projectRoot}/src/**/*.d.ts"
      ],
      "options": {
        "cwd": "projects/schematics",
        "commands": [
          "npm run clean",
          "npm --prefix ../../ run generate:deps",
          "../../node_modules/.bin/tsc -p ./tsconfig.schematics.json"
        ],
        "parallel": false
      },
      "cache": true
    }
  },
  "tags": ["type:util"]
}
