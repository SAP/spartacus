{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "newProjectRoot": "",
  "projects": {
    "schematics-test": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "configurations": {
            "development": {
              "extractLicenses": false,
              "optimization": false,
              "sourceMap": true,
            },
            "noSsr": {
              "prerender": false,
              "ssr": false,
            },
            "production": {
              "budgets": [
                {
                  "maximumError": "3.5mb",
                  "maximumWarning": "500kB",
                  "type": "initial",
                },
                {
                  "maximumError": "8kB",
                  "maximumWarning": "4kB",
                  "type": "anyComponentStyle",
                },
              ],
              "outputHashing": "all",
            },
          },
          "defaultConfiguration": "production",
          "options": {
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
              },
            ],
            "browser": "src/main.ts",
            "inlineStyleLanguage": "scss",
            "polyfills": [
              "zone.js",
            ],
            "prerender": false,
            "security": {
              "allowedHosts": [],
            },
            "server": "src/main.server.ts",
            "ssr": {
              "entry": "src/server.ts",
            },
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules/",
              ],
              "sass": {
                "silenceDeprecations": [
                  "import",
                ],
              },
            },
            "styles": [
              "src/styles.scss",
            ],
            "tsConfig": "tsconfig.app.json",
          },
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
