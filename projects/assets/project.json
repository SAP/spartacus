{
  "name": "assets",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/assets/src",
  "projectType": "library",
  "prefix": "cx",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run assets:build-only && ts-node tools/scripts/regex-scss-path-replace.ts dist/assets"
      },
      "configurations": {
        "production": {
          "command": "nx run assets:build-only:production && ts-node tools/scripts/regex-scss-path-replace.ts dist/assets"
        }
      }
    },
    "build-only": {
      "executor": "@angular-devkit/build-angular:ng-packagr",
      "options": {
        "tsConfig": "projects/assets/tsconfig.lib.json",
        "project": "projects/assets/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "projects/assets/tsconfig.lib.prod.json"
        }
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "projects/assets/**/*.ts",
          "projects/assets/**/*.html"
        ]
      }
    }
  },
  "tags": ["type:util"]
}
