{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "baseUrl": "../node_modules",
    "strict": false,
    "typeRoots": ["../node_modules/@types", "../node_modules"],
    "types": ["cypress", "@testing-library/cypress", "cypress-file-upload"],
    "target": "es5",
    "lib": ["esnext", "dom"]
  },
  "include": ["**/*.*"],
  "exclude": ["./dist"]
}
