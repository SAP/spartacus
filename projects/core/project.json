{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "projects/core/src",
  "projectType": "library",
  "prefix": "cx",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run core:build-only && ts-node tools/scripts/regex-scss-path-replace.ts dist/core"
      },
      "configurations": {
        "production": {
          "command": "nx run core:build-only:production && ts-node tools/scripts/regex-scss-path-replace.ts dist/core"
        }
      }
    },
    "build-only": {
      "executor": "./tools/build-lib:augmented-types",
      "options": {
        "tsConfig": "projects/core/tsconfig.lib.json",
        "project": "projects/core/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "projects/core/tsconfig.lib.prod.json"
        }
      }
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "main": "projects/core/src/test.ts",
        "tsConfig": "projects/core/tsconfig.spec.json",
        "polyfills": ["zone.js", "zone.js/testing"],
        "karmaConfig": "projects/core/karma.conf.js"
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": ["projects/core/**/*.ts", "projects/core/**/*.html"]
      }
    }
  },
  "tags": ["type:util", "scope:core"]
}
