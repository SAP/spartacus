{
  "permissions": {
    "allow": [
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(git *)",
      "Bash(git push *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(gh *)",
      "Bash(gh pr create *)",
      "Bash(GH_TOKEN=* gh *)",
      "Bash(GH_TOKEN=* GH_HOST=* gh *)",

      "Task",
      "Agent",

      "mcp__sap-jira__jira_search",
      "mcp__sap-jira__jira_get_issue"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "additionalDirectories": ["/tmp"]
  },
  "enabledMcpjsonServers": ["playwright", "sap-jira"]
}
